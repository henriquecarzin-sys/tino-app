# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Essas duas são as ÚNICAS variáveis que devem existir no
# frontend — qualquer coisa com VITE_ vai parar no bundle JS público do navegador.
#
# NUNCA coloque aqui: chaves de serviço do Supabase, OPENAI_API_KEY ou ANTHROPIC_API_KEY.
# Essas são segredos de servidor — vivem em `supabase secrets set`, não em .env do Vite.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
